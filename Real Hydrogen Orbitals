import numpy as np
import matplotlib.pyplot as plt
from scipy.special import assoc_laguerre, sph_harm_y
import math
from skimage import measure


def hydrogen_probability_density(n, l, m, X, Y, Z, a0=1.0):

    r = np.sqrt(X**2 + Y**2 + Z**2) + 1e-12
    theta = np.arccos(np.clip(Z / r, -1, 1))
    phi = np.arctan2(Y, X)

    rho = (2.0 / (n * a0)) * r

    L = assoc_laguerre(rho, n - l - 1, 2 * l + 1)

    norm_radial = np.sqrt(
        (2.0 / (n * a0))**3 *
        math.factorial(n - l - 1) /
        (2.0 * n * math.factorial(n + l))
    )

    R = norm_radial * np.exp(-rho / 2) * rho**l * L
    Ylm = sph_harm_y(l, m, theta, phi)
    Ylm_ = sph_harm_y(l, -m, theta, phi)
    psi = R * (Ylm - Ylm_) / (1j * np.sqrt(2))
    return np.abs(psi)**2


#sets up grid
N = 80
lim = 25

x = np.linspace(-lim, lim, N)
y = np.linspace(-lim, lim, N)
z = np.linspace(-lim, lim, N)

X, Y, Z = np.meshgrid(x, y, z, indexing='ij')

#Determines probable coordiantes
n, l, m = 2, 1, -1

P = hydrogen_probability_density(n, l, m, X, Y, Z)

P = P / P.max()

level = 0.05  # adjust this for detail

verts, faces, normals, values = measure.marching_cubes(P, level=level)
# convert voxel coords → real space
verts = verts * (2 * lim / (N - 1)) - lim

#Plots isosurfsace
fig = plt.figure(figsize=(10, 8))
ax = fig.add_subplot(111, projection='3d')

ax.plot_trisurf(
    verts[:, 0],
    verts[:, 1],
    faces,
    verts[:, 2],
    cmap='inferno',
    lw=0.2
)

ax.set_title(f"Hydrogen Orbital Isosurface (n={n}, l={l}, m={m})")
ax.set_xlabel("x")
ax.set_ylabel("y")
ax.set_zlabel("z")

plt.show()

